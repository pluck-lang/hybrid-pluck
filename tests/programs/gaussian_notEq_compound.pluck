; Compound-expression exclusion: same affine combination `x + y` is both
; pinned to 1.0 (equality) and excluded from 1.0 (exclusion). Contradictory,
; so P(evidence) = 0 and the posterior is empty.
(query
  (let (x (gaussian 0.0 1.0))
    (let (y (gaussian 0.0 1.0))
      (Posterior
        True
        (and (real_eq (+. x y) 1.0)
             (not (real_eq (+. x y) 1.0)))))))
