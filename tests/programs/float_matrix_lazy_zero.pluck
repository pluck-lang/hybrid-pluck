; `*. 0 thunk` must not force the thunk. The thunk here is a literal Gaussian
; expression; if the short-circuit fires we never register the Gaussian prior
; and the resulting posterior has no Gaussian block.
(query
  (let ((m (*. 0.0 {(gaussian 0.0 1.0), (gaussian 0.0 1.0)})))
    (Posterior m True)))
