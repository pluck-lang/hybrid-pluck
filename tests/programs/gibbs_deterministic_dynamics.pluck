; Fully deterministic Gibbs: cond pins both x and y to True via
; `(and x (iff x y))`, and the chain is seeded with `(WithConstant (True))`
; (x = True), which the cond already forces. Every block update resamples a
; variable that's already forced to True. All ten query samples must be True
; regardless of RNG state.
(query
  gibbs-deterministic
  (let ((x (flip 0.5))
        (y (flip 0.5)))
    (Gibbs (if x (True) (False))
           (and x (iff x y))
           10
           [x, y]
           (WithConstant (True)))))
