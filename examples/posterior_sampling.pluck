; Posterior sampling draws exact samples
; from the posterior distribution, using the
; compiled evidence BDD as a constraint.

(define (random_char)
  (uniform_int_range @8 @32 @126))
(define (char=? a b) (int_dist_eq a b))
(define string=? (list=? char=?))

(define (random_string p)
  (if (flip p) (Nil) (Cons (random_char) (random_string p))))
(define (perturb s)
  (match s
     Nil => (random_string 0.99)
     Cons c cs =>
       (let
         (do_delete (flip 0.01)
          insertion (random_string 0.99)
          perturbed_cs (perturb cs))
        (if do_delete
          perturbed_cs
          (append insertion (Cons (if (flip 0.01) (random_char) c) perturbed_cs))))))

; What original string produced "bat" as a typo?
(query
 what-was-original
 (let ((original (if (flip 0.5) "cat" "bat")))
   (PosteriorSamples
     original
     (string=? (perturb original) "bat")
     10)))

; Given Mary called, was there a burglary?
(query
 burglary-samples
 (let ((earthquake (flip 0.0001))
       (burglary (flip 0.001))
       (alarm (or earthquake burglary))
       (phoneWorking (flip (if earthquake 0.7 0.99)))
       (maryWakes (flip (if alarm (if earthquake 0.8 0.6) 0.2)))
       (called (and maryWakes phoneWorking)))
   (PosteriorSamples burglary called 10)))
