; A 100-node diamond network.
; What is the probability a message gets through?
(define (diamond s1)
  (let (route (flip 0.5)
              drop (flip 0.0001))
    (and (or (not drop) route) s1)))

(define (network n)
  (match n
    O => (True)
    S m => (diamond (network m))))

(query network-100 (Marginal (network 100)))
