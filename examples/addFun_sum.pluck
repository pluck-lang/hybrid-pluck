;; title: addFun_sum
;; Port of Alea.jl/benchmarks/addFun_sum.jl
;;
;; Three independent draws x_i ~ N(0,1); the model sums all three, x1 + x2 + x3.
;; Dice reports E[sum]; pluck returns the full marginal, which is N(0, sqrt(3)).

(query addFun_sum
  (Marginal
    (let ((x1 (gaussian 0.0 1.0))
          (x2 (gaussian 0.0 1.0))
          (x3 (gaussian 0.0 1.0)))
      (+. (+. x1 x2) x3))))
